# Variables de entorno de ProductFarma.
# - Cloudflare Pages: Settings > Variables and Secrets (todas salvo las de sync).
# - GitHub Actions:   Settings > Secrets and variables > Actions (las de Makito y Supabase).
# NUNCA subas un .env con valores al repositorio.

# --- Makito API B2B (https://apis.makito.es) ---
# Empieza con las credenciales Sandbox (los pedidos NO se procesan); luego cambia a las Reales.
MAKITO_API_BASE=https://apis.makito.es
MAKITO_CLIENT_ID=
MAKITO_CLIENT_SECRET=
MAKITO_LANG=es
# true = "amount" de /price-list es el importe por "baseQuantity" unidades (verificar con un producto real)
MAKITO_PRICE_PER_BASE=true

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # solo en Cloudflare y GitHub Secrets, nunca en el navegador

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://productfarma.pages.dev

# --- Seguridad interna ---
ADMIN_KEY=                      # clave larga aleatoria (openssl rand -hex 32) para enviar pedidos a Makito

# --- Reglas de venta ---
VAT_RATE=0.21
QUOTE_THRESHOLD_EUR=1500        # por encima, solo presupuesto

# --- Filtro farmacia (opcional; ya hay una lista por defecto en lib/sync.mjs) ---
PHARMA_INCLUDE=                 # palabras extra que activan un producto, separadas por comas
PHARMA_EXCLUDE=                 # palabras que lo excluyen
PHARMA_REFS=                    # referencias Makito que se publican siempre
