# --- Makito API B2B (https://apis.makito.es) ---
# Credenciales: Client ID / Client Secret del email de Makito.
# Empieza con las de modo Sandbox (los pedidos NO se procesan); luego cambia a las Reales.
MAKITO_API_BASE=https://apis.makito.es
MAKITO_CLIENT_ID=
MAKITO_CLIENT_SECRET=
MAKITO_LANG=es
# true = "amount" de /price-list es el importe por "baseQuantity" unidades (verificar con un producto real)
MAKITO_PRICE_PER_BASE=true

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # solo en Netlify (servidor), nunca en el navegador

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://productfarma.netlify.app

# --- Seguridad interna ---
SYNC_SECRET=          # clave larga aleatoria para lanzar la sync a mano
ADMIN_KEY=            # clave larga aleatoria para enviar pedidos a Makito

# --- Reglas de venta ---
VAT_RATE=0.21
QUOTE_THRESHOLD_EUR=1500        # por encima, se recomienda presupuesto
NOTIFY_EMAIL=

# --- Filtro farmacia (opcional; ya hay una lista por defecto en makito-sync.mjs) ---
PHARMA_INCLUDE=        # palabras extra que activan un producto, separadas por comas
PHARMA_EXCLUDE=        # palabras que lo excluyen
PHARMA_REFS=           # referencias Makito que se publican siempre
