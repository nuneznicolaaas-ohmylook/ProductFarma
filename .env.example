# --- Makito API B2B (OAuth client_credentials) ---
# Pruebas: los pedidos NO se procesan. Producción: SÍ se procesan.
MAKITO_API_BASE=
MAKITO_CLIENT_ID=
MAKITO_CLIENT_SECRET=
# Rutas (ajustar a https://data.makito.es/apis_b2b/index.html)
MAKITO_PATH_TOKEN=/oauth/token
MAKITO_PATH_PRODUCTS=/products
MAKITO_PATH_PRICES=/prices
MAKITO_PATH_STOCK=/stock
MAKITO_PATH_PRINT=/printing
MAKITO_PATH_ORDERS=/orders

# --- Alternativa: feeds XML clásicos (solo si no hay CLIENT_ID) ---
MAKITO_API_KEY=
MAKITO_BASE_URL=https://print.makito.es
# Rutas de los feeds XML (cópialas exactas de tu área de clientes; {key} se sustituye por la clave)
MAKITO_PRODUCTS_PATH=/xml/allproducts.php?pszinternal={key}
MAKITO_PRICES_PATH=/xml/pricefeed.php?pszinternal={key}
MAKITO_STOCK_PATH=/xml/stockfeed.php?pszinternal={key}
MAKITO_PRINT_PATH=/xml/allprintdatafile.php?pszinternal={key}

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # solo en Netlify (servidor), nunca en el navegador

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://productfarma.netlify.app

# --- Seguridad interna ---
SYNC_SECRET=          # clave larga aleatoria para lanzar la sync a mano
ADMIN_KEY=            # clave larga aleatoria para enviar pedidos a Makito

# --- Reglas de venta ---
VAT_RATE=0.21
QUOTE_THRESHOLD_EUR=1500        # por encima, se recomienda presupuesto
NOTIFY_EMAIL=
